# Normalize text files to LF in the repository; checkout follows local settings
* text=auto

# Files executed inside Linux containers / on Raspberry Pi must always be LF,
# even on a Windows checkout with core.autocrlf=true
*.sh           text eol=lf
Dockerfile     text eol=lf
Makefile       text eol=lf
docker-compose.yml text eol=lf
docker/**      text eol=lf

# Binary artifacts: never touch line endings or diff as text
*.png  binary
*.jpg  binary
*.pdf  binary
*.pth  binary
*.pkl  binary
*.npy  binary
